FROM python:3.13.5-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y libegl1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir pyside6-essentials==6.11.2 pytest==9.0.2

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
       libdbus-1-3 libfontconfig1 libgl1 libglib2.0-0 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

ENV QT_QPA_PLATFORM=offscreen
WORKDIR /workspace
