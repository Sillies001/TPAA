  "qa_001_frame_convention": {
    "quaternion_element_order": [
      "w",
      "x",
      "y",
      "z"
    ],
    "quaternion_equivalence": "Q_AND_NEGATIVE_Q_SAME_ROTATION",
    "quaternion_normalization_rule": "FINITE_NONZERO_NORMALIZE_BEFORE_ROTATION",
    "own_attitude_quaternion_semantics": {
      "interpretation": "ACTIVE_ROTATION",
      "source_frame": "OWN_BODY_FRD",
      "destination_frame": "ECEF",
      "symbol": "q_ecef_from_body"
    },
    "own_body_axes": {
      "handedness": "RIGHT_HANDED",
      "x_axis": "+X_FORWARD",
      "y_axis": "+Y_RIGHT",
      "z_axis": "+Z_DOWN"
    },
    "ecef_to_own_body_vector_rule": "r_body = R(q_ecef_from_body)^T * r_ecef",
    "azimuth": {
      "formula": "atan2(y_body,x_body)",
      "zero_axis": "+X_FORWARD",
      "positive_direction": "+X_TOWARD_+Y",
      "wrap_interval_rad": "[-pi,pi)"
    },
    "elevation": {
      "formula": "atan2(-z_body,hypot(x_body,y_body))",
      "zero_plane": "OWN_BODY_XY",
      "positive_direction": "UP_TOWARD_-Z",
      "range_rad": "[-pi/2,pi/2]"
    },
    "sensor_boresight_quaternion_semantics": {
      "interpretation": "ACTIVE_ROTATION",
      "source_frame": "SENSOR_FRD",
      "destination_frame": "OWN_BODY_FRD",
      "symbol": "q_body_from_sensor"
    },
    "sensor_vector_rule": "r_sensor = R(q_body_from_sensor)^T * r_body",
    "sensor_composition_rule": "R_sensor_from_ecef = R(q_body_from_sensor)^T * R(q_ecef_from_body)^T",
    "missing_sensor_boresight_rule": "sensor_az_rad=null; sensor_el_rad=null; sensor_frame_status=NOT_CONFIGURED",
    "valid_range_rule": "range_m > 0"
  },
  "qa_002_uncertainty_contract": {
    "p_inputs_dimension": 6,
    "p_inputs_order": [
      "target_position_ecef_x_m",
      "target_position_ecef_y_m",
      "target_position_ecef_z_m",
      "own_position_ecef_x_m",
      "own_position_ecef_y_m",
      "own_position_ecef_z_m"
    ],
    "p_inputs_units": "m",
    "p_inputs_covariance_units": "m^2",
    "p_inputs_frame": "ECEF",
    "relative_state_jacobian": {
      "shape": [
        3,
        6
      ],
      "row_semantics": [
        "r_rel_ecef_x_m",
        "r_rel_ecef_y_m",
        "r_rel_ecef_z_m"
      ],
      "column_semantics": [
        "target_position_ecef_x_m",
        "target_position_ecef_y_m",
        "target_position_ecef_z_m",
        "own_position_ecef_x_m",
        "own_position_ecef_y_m",
        "own_position_ecef_z_m"
      ],
      "canonical_relative_position_rule": "r_rel_ecef = p_target_ecef - p_own_ecef",
      "canonical_jacobian": "[I3|-I3]"
    },
    "position_uncertainty_mapping": {
      "own_position_uncertainty_ref": "Require 3x3 ECEF covariance in m^2; populate P_inputs[3:6,3:6].",
      "target_position_uncertainty_ref": "Require 3x3 ECEF covariance in m^2; populate P_inputs[0:3,0:3].",
      "non_covariance_position_representation_rule": "FAIL_CLOSED_FOR_QA002_V1"
    },
    "time_alignment_uncertainty_mapping": {
      "conversion": "Resolve sigma_t_seconds from CONTRACT_NAV_UNCERTAINTY_REPRESENTATION_V1; TWO_SIDED_HARD_BOUND +/-b uses sigma=b/sqrt(3). Convert us to s.",
      "shared_error_vector": "g_time = [v_target_ecef_mps ; v_own_ecef_mps]",
      "covariance_rule": "P_time = sigma_t_seconds^2 * g_time * g_time^T",
      "merge_rule": "P_inputs = P_position + P_time",
      "cross_covariance_effect": "Shared time error creates nonzero target-own cross covariance and MUST NOT be block-diagonalized."
    },
    "cross_covariance_rule": {
      "source_position_cross_covariance": "ABSENT_MEANS_ZERO_BY_AUTHORITY_FOR_QA002_V1",
      "shared_time_cross_covariance": "REQUIRED_AS_DEFINED_BY_P_TIME",
      "other_hidden_cross_terms": "FORBIDDEN"
    },
    "attitude_uncertainty_mapping": {
      "own_attitude_uncertainty_ref": {
        "representation": "Resolve scalar small-angle sigma_rad; SIGMA_1D direct, 1x1 COVARIANCE sqrt(var), TWO_SIDED_HARD_BOUND b/sqrt(3).",
        "p_inputs_contribution": "ZERO_TRANSLATIONAL_SENSITIVITY",
        "angular_projection": "After P_rel is rotated to OWN_BODY_FRD, add sigma_att^2/cos(el)^2 to azimuth variance and sigma_att^2 to elevation variance.",
        "singularity_rule": "horizontal_range_m > 0 required for VALID azimuth/elevation uncertainty"
      },
      "target_attitude_uncertainty_ref": {
        "required_for_provenance": true,
        "p_inputs_contribution": "ZERO_TRANSLATIONAL_SENSITIVITY",
        "output_sensitivity": "ZERO_FOR_QA001_V1_RELATIVE_POSITION_AND_OWN_BODY_ANGLES"
      }
    },
    "propagation": {
      "p_rel_rule": "P_rel_ecef = J * P_inputs * J^T",
      "body_covariance_rule": "P_rel_body = R(q_ecef_from_body)^T * P_rel_ecef * R(q_ecef_from_body)",
      "sigma_range_rule": "sqrt(g_range * P_rel_body * g_range^T)",
      "sigma_az_rule": "sqrt(g_az * P_rel_body * g_az^T + own_attitude_az_variance)",
      "sigma_el_rule": "sqrt(g_el * P_rel_body * g_el^T + own_attitude_el_variance)",
      "sigma_position_3d_rule": "sqrt(trace(P_rel_ecef))"
    }
  },
