{
  "schema": "TPAA_TASK_METRIC_DEFINITION_V1",
  "definition_id": "TPAA-TASK-KILL-RATIO-1.0.0-candidate",
  "semantic_id": "KILL_RATIO",
  "definition_version": "1.0.0",
  "algorithm_id": "tpaa.assessment.task.kill_ratio",
  "algorithm_version": "1.0.0",
  "algorithm_contract_sha256": "70ecfc5eb8d62e6198d48b3c9949904a4a97d9e49416332e934389b3cbc19e56",
  "name_zh": "击落比（任务评估）",
  "name_en": "Task Kill Ratio",
  "value_kind": "DECIMAL_RATIO",
  "unit": "1",
  "direction": "HIGHER_IS_BETTER",
  "display_decimal_places": 3,
  "applicable_training_types": [
    "BVR",
    "WVR"
  ],
  "evaluated_subject": {
    "kind": "SIDE",
    "field": "evaluated_side",
    "required": true,
    "allowed_values": [
      "RED",
      "BLUE"
    ]
  },
  "scope_contract": {
    "required": [
      "batch_id",
      "session_id",
      "release_id",
      "context_id",
      "evaluated_side",
      "opponent_side",
      "phase_scope",
      "start_session_time_us",
      "end_session_time_us"
    ],
    "interval": "[start_session_time_us,end_session_time_us)",
    "latest_fallback": "FORBIDDEN",
    "cross_batch_borrowing": "FORBIDDEN",
    "evaluated_side_required": true
  },
  "input_binding": [
    {
      "field": "loss_id/final_j_state/side",
      "owner": "assessment.adjudicated_loss",
      "required": true
    },
    {
      "field": "engagement_id/category/qualification_status",
      "owner": "assessment.engagement_episode",
      "required": true
    },
    {
      "field": "batch_id/session_id/release_id/context_id",
      "owner": "exact_scope",
      "required": true
    }
  ],
  "numerator_rule": {
    "source": "assessment.adjudicated_loss",
    "count": "unique loss_id",
    "where": [
      "FINAL_CONFIRMED_LOSS",
      "final_j_state=APPROVED",
      "side=opponent_side",
      "exact_scope",
      "not_superseded",
      "attributable_to_eligible_engagement"
    ]
  },
  "denominator_rule": {
    "source": "assessment.engagement_episode",
    "count": "unique engagement_id",
    "where": [
      "category IN BVR,WVR",
      "qualification_status=ELIGIBLE",
      "adjudication_state=FINAL",
      "both_sides_participate",
      "exact_scope"
    ]
  },
  "deduplication_rule": {
    "identity": "loss_id and engagement_id",
    "multiple_weapon_events_one_loss": "COUNT_ONCE",
    "superseded": "EXCLUDE",
    "launch_count_as_denominator": "FORBIDDEN"
  },
  "zero_denominator_rule": {
    "status": "N_A",
    "reason_code": "ZERO_ELIGIBLE_ENGAGEMENTS",
    "value": null
  },
  "missing_rule": {
    "pending": "PENDING",
    "missing_required_source": "INSUFFICIENT",
    "conflicting_adjudication": "INVALID",
    "unknown_not_zero": true
  },
  "j_state_rule": {
    "pending": "PENDING",
    "conflict": "INVALID",
    "final_approved": "ELIGIBLE_FOR_CALCULATION",
    "unknown": "PENDING"
  },
  "qualification_rule": {
    "eligible_engagement_requires": [
      "BVR_OR_WVR",
      "BOTH_SIDES_PARTICIPATE",
      "FINAL_ADJUDICATION",
      "SOURCE_COVERAGE_PASS"
    ],
    "strike_excluded": true,
    "training_cancelled_excluded": true,
    "unknown_side_excluded": true
  },
  "aggregation_rule": {
    "mode": "SUM_NUMERATOR_AND_DENOMINATOR_THEN_DIVIDE",
    "simple_average": "FORBIDDEN",
    "comparison_authority": "TASK_METRIC_COMPARABILITY_AUTHORITY",
    "comparison_keys": [
      "semantic_id",
      "definition_version",
      "definition_sha256",
      "algorithm_id",
      "algorithm_version",
      "evaluated_side",
      "training_type",
      "phase_scope",
      "quality_gate_version"
    ]
  },
  "evidence_requirements": [
    "loss_id",
    "engagement_id",
    "world_relation_refs",
    "adjudication_refs",
    "release_id",
    "context_id",
    "source_refs",
    "evidence_refs"
  ],
  "permission_contract": [
    "task_metric.definition.read",
    "task_metric.result.read",
    "task_metric.compare",
    "task_metric.admission.read"
  ],
  "audit_contract": [
    "TASK_METRIC_DEFINITION_READ",
    "TASK_METRIC_RESULT_READ",
    "TASK_METRIC_COMPARE",
    "TASK_METRIC_CANDIDATE_EXPORTED"
  ],
  "admission_status": "CANDIDATE_TEST_ONLY",
  "business_approval_required": true,
  "release_claim": false,
  "definition_sha256": "061549d4186ae2680de7207e36a2d67b7e1223e115a3e27009c1542c5e24cf39"
}
