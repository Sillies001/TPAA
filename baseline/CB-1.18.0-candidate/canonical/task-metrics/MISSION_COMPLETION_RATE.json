{
  "schema": "TPAA_TASK_METRIC_DEFINITION_V1",
  "definition_id": "TPAA-TASK-MISSION-COMPLETION-RATE-1.0.0-candidate",
  "semantic_id": "MISSION_COMPLETION_RATE",
  "definition_version": "1.0.0",
  "algorithm_id": "tpaa.assessment.task.mission_completion_rate",
  "algorithm_version": "1.0.0",
  "algorithm_contract_sha256": "c1d62f36b14200bbcf300d7087e9e1560c40f3c10464f3df9adeb9b91f3ed560",
  "name_zh": "任务完成率",
  "name_en": "Mission Completion Rate",
  "value_kind": "DECIMAL_PERCENTAGE",
  "unit": "%",
  "direction": "HIGHER_IS_BETTER",
  "display_decimal_places": 1,
  "applicable_training_types": [
    "BVR",
    "WVR",
    "STRIKE",
    "BASIC_FLIGHT",
    "MIXED"
  ],
  "evaluated_subject": {
    "kind": "SIDE",
    "field": "evaluated_side",
    "required": true,
    "allowed_values": [
      "RED",
      "BLUE"
    ]
  },
  "scope_contract": {
    "required": [
      "batch_id",
      "session_id",
      "release_id",
      "context_id",
      "evaluated_side",
      "opponent_side",
      "phase_scope",
      "start_session_time_us",
      "end_session_time_us"
    ],
    "interval": "[start_session_time_us,end_session_time_us)",
    "latest_fallback": "FORBIDDEN",
    "cross_batch_borrowing": "FORBIDDEN",
    "evaluated_side_required": true
  },
  "input_binding": [
    {
      "field": "objective_id/objective_code/required/plan_revision_id",
      "owner": "assessment.mission_objective_plan",
      "required": true
    },
    {
      "field": "achieved/adjudication_refs/evidence_set_id",
      "owner": "assessment.objective_result",
      "required": true
    },
    {
      "field": "batch_id/session_id/release_id/context_id",
      "owner": "exact_scope",
      "required": true
    }
  ],
  "numerator_rule": {
    "source": "assessment.objective_result",
    "count": "unique required objective_id with achieved=true and final approved J",
    "where": [
      "objective_id in frozen_required_plan_revision",
      "achieved=true",
      "approved=true",
      "exact_scope"
    ]
  },
  "denominator_rule": {
    "source": "assessment.mission_objective_plan",
    "count": "unique objective_id",
    "where": [
      "required=true",
      "valid_at_mission_start",
      "not CANCELLED_BEFORE_EFFECTIVE",
      "plan_revision_frozen"
    ]
  },
  "deduplication_rule": {
    "identity": "objective_id within immutable plan_revision_id",
    "optional_objectives": "EXCLUDE",
    "weighting": "NOT_USED_IN_VERSION_1_0_0"
  },
  "zero_denominator_rule": {
    "status": "N_A",
    "reason_code": "ZERO_ELIGIBLE_REQUIRED_OBJECTIVES",
    "value": null
  },
  "missing_rule": {
    "pending": "PENDING",
    "missing_required_source": "INSUFFICIENT",
    "conflicting_adjudication": "INVALID",
    "unknown_not_zero": true
  },
  "j_state_rule": {
    "pending": "PENDING",
    "conflict": "INVALID",
    "final_approved": "ELIGIBLE_FOR_CALCULATION",
    "unknown": "PENDING"
  },
  "qualification_rule": {
    "plan_frozen_at_mission_start": true,
    "required_only": true,
    "optional_excluded": true,
    "weighting": false,
    "task_start_plan_revision_required": true
  },
  "aggregation_rule": {
    "mode": "SUM_NUMERATOR_AND_DENOMINATOR_THEN_DIVIDE",
    "simple_average": "FORBIDDEN",
    "comparison_authority": "TASK_METRIC_COMPARABILITY_AUTHORITY",
    "comparison_keys": [
      "semantic_id",
      "definition_version",
      "definition_sha256",
      "algorithm_id",
      "algorithm_version",
      "evaluated_side",
      "training_type",
      "phase_scope",
      "quality_gate_version"
    ]
  },
  "evidence_requirements": [
    "plan_revision_id",
    "required_objective_ids",
    "objective_result_ids",
    "adjudication_refs",
    "release_id",
    "context_id",
    "evidence_set_id"
  ],
  "permission_contract": [
    "task_metric.definition.read",
    "task_metric.result.read",
    "task_metric.compare",
    "task_metric.admission.read"
  ],
  "audit_contract": [
    "TASK_METRIC_DEFINITION_READ",
    "TASK_METRIC_RESULT_READ",
    "TASK_METRIC_COMPARE",
    "TASK_METRIC_CANDIDATE_EXPORTED"
  ],
  "admission_status": "CANDIDATE_TEST_ONLY",
  "business_approval_required": true,
  "release_claim": false,
  "definition_sha256": "ac79959d9f7c54fd0bf60cc34402bf5deafe8f7fbca8598cc5c693b9cd4af223"
}
