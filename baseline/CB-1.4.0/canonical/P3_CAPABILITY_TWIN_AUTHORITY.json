    "schema_version": "TPAA_P3_MODEL_VALIDATION_V1",
    "frozen_required": true,
    "training_snapshot_type": "P3_MODEL_TRAINING",
    "training_validation_identity_overlap_forbidden": true,
    "training_validation_episode_overlap_forbidden": true,
    "validation_strategy": "TEMPORAL_LAST_POINT_HOLDOUT_THEN_FINAL_REFIT",
    "minimum_total_eligible_points": 4,
    "holdout_points": 1,
    "training_prefix_min_points": 3,
    "training_prefix_max_points": 5,
    "heldout_prediction_rule": "OLS_TRAINING_PREFIX_AT_HELDOUT_SESSION_ORDER",
    "heldout_acceptance_rule": "ABS_ERROR_LE_MAX_TRAINING_MAD_PLUS_HELDOUT_P2_HALF_WIDTH",
    "final_refit_rule": "AFTER_VALIDATION_PASS_REFIT_LAST_UP_TO_5_ELIGIBLE_POINTS_INCLUDING_HELDOUT",
    "validation_failure_blocks_model_publication": true,
    "implementation_selected_threshold_forbidden": true
  },
