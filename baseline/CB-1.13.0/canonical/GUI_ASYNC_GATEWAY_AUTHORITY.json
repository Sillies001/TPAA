{
  "authority_id": "GUI_ASYNC_GATEWAY_AUTHORITY",
  "authority_version": "1.0.0",
  "core_baseline": "CB-1.13.0",
  "parent_core_baseline": "CB-1.12.0",
  "decision_id": "G8-V33-CO-ATTACK-2026-11-07",
  "approval_id": "G8-CB-1.13.0-LOCAL-IMPLEMENTATION-2026-11-07",
  "approval_status": "APPROVED_LOCAL",
  "activation_status": "ACTIVE",
  "routes": [
    {
      "route_id": "gui.bootstrap",
      "method": "GET",
      "path": "/api/v1/gui/bootstrap",
      "response_dto": "GuiBootstrapDTO"
    },
    {
      "route_id": "gui.catalog",
      "method": "GET",
      "path": "/api/v1/gui/catalog",
      "response_dto": "GuiCatalogDTO"
    },
    {
      "route_id": "gui.selector",
      "method": "GET",
      "path": "/api/v1/gui/selectors/{selector_id}",
      "response_dto": "GuiSelectorDTO"
    }
  ],
  "selectors": [
    {
      "selector_id": "modules",
      "source": "MACHINE_AUTHORITY",
      "context": []
    },
    {
      "selector_id": "views",
      "source": "MACHINE_AUTHORITY",
      "context": []
    },
    {
      "selector_id": "releases",
      "source": "APPLICATION_QUERY",
      "context": [
        "principal",
        "session_id"
      ]
    },
    {
      "selector_id": "contexts",
      "source": "APPLICATION_QUERY",
      "context": [
        "principal",
        "release_id"
      ]
    },
    {
      "selector_id": "batches",
      "source": "APPLICATION_QUERY",
      "context": [
        "principal"
      ]
    },
    {
      "selector_id": "weapon_events",
      "source": "APPLICATION_QUERY",
      "context": [
        "principal",
        "batch_id",
        "release_id"
      ]
    },
    {
      "selector_id": "perspectives",
      "source": "APPLICATION_QUERY",
      "context": [
        "principal",
        "weapon_event_id"
      ]
    }
  ],
  "request_policy": {
    "default_timeout_ms": 8000,
    "maximum_timeout_ms": 30000,
    "deduplicate_inflight": true,
    "cancel_superseded": true,
    "discard_stale_response": true,
    "retry_unsafe_methods": false
  },
  "cache_policy": {
    "storage": "SESSION_MEMORY_ONLY",
    "partition_keys": [
      "principal_cache_key",
      "release_id"
    ],
    "cross_principal": "FORBIDDEN",
    "cross_release": "FORBIDDEN",
    "clear_on_partition_change": true,
    "catalog_ttl_ms": 60000,
    "bootstrap_ttl_ms": 0,
    "selector_ttl_ms": 15000
  },
  "pagination_policy": {
    "cursor": "OPAQUE_VERSIONED",
    "default_limit": 50,
    "maximum_limit": 100,
    "maximum_pages_per_collection": 100,
    "cursor_loop_policy": "ERROR"
  },
  "range_policy": {
    "session_time_transport": "DECIMAL_STRING",
    "lod_values": [
      "SUMMARY",
      "BALANCED",
      "DETAIL"
    ],
    "default_max_points": 2000,
    "maximum_points": 10000,
    "preserve_extrema": true,
    "preserve_event_anchors": true
  },
  "media_ticket_policy": {
    "ticket": "OPAQUE_SHORT_LIVED",
    "absolute_path": "FORBIDDEN",
    "range_required": true,
    "content_type_required": true,
    "size_required": true
  },
  "error_policy": {
    "dto": "GuiGatewayErrorDTO",
    "codes": [
      "ABORTED",
      "TIMEOUT",
      "STALE_RESPONSE",
      "CURSOR_INVALID",
      "CURSOR_LOOP",
      "CONTEXT_REQUIRED",
      "FORBIDDEN",
      "NOT_FOUND",
      "BACKEND_UNAVAILABLE",
      "INVALID_RESPONSE",
      "SYSTEM_ERROR"
    ],
    "unknown": "SYSTEM_ERROR_FAIL_CLOSED",
    "reason_and_provenance_required": true
  },
  "release_claim": false
}
