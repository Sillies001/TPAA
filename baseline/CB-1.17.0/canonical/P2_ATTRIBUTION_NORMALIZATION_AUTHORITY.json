        "source_release_id",
        "p2_release_id",
        "attribution_run_id",
        "aircraft_id",
        "capability_type",
        "reference_condition_id",
        "adjusted_value",
        "unit",
        "uncertainty",
        "residual",
        "factor_effects",
        "claim_level",
        "status",
        "reason_codes",
        "evidence_set_id",
        "estimate_time",
        "created_at",
        "supersedes_estimate_id"
      ]
    },
    "P2AdmissionStateDTO": {
      "fields": [
        "source_revision",
        "event_name",
