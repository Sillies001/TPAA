        "SETUP_ENTRY",
        "EXECUTION",
        "STABILIZATION_RECOVERY",
        "COMPLETION"
      ],
      "terminator_marker": "END",
      "terminator_is_stage": false,
      "interval_construction": "stage_i=[marker_i,marker_i+1)",
      "fail_closed_on": [
        "missing END marker",
        "duplicate or out-of-order governed Stage marker",
        "marker outside Episode interval",
        "Stage interval crossing Episode revision boundary",
        "unrecognized Stage code"
      ]
    },
    "revision_rule": "corrections create a new row linked by supersedes_stage_id",
    "published_history_mutable": false,
    "required_quality_fields": [
      "stage_status",
      "coverage",
      "confidence",
      "detector_version"
