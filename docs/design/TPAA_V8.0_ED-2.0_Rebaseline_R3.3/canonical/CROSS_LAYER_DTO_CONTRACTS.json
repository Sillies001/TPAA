          "type": "object[]",
          "required": true
        },
        {
          "field": "cohort",
          "type": "object[]",
          "required": true
        }
      ],
      "rules": [
        "Read exact context_id; never resolve current/latest revision for historical release.",
        "artifact_refs stable-sort by binding_role.",
        "Missing frozen artifact => CONTEXT_ARTIFACT_UNAVAILABLE; no fallback.",
        "Unsupported historical artifact schema => CONTEXT_ARTIFACT_SCHEMA_UNSUPPORTED; no coercion."
      ]
    }
  },
  "transport_rules": {
    "session_time_us": "decimal-string for JS-visible API",
    "uuid": "canonical UUID string",
    "structured_metric": "object, never JSON string"
  }
