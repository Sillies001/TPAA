    "EvaluationContextBundleDTO": {
      "projection_fields": [
        {
          "field": "context",
          "type": "EvaluationContextDTO",
          "required": true
        },
        {
          "field": "artifact_refs",
          "type": "ContextArtifactRefDTO[]",
          "required": true
        },
        {
          "field": "scenario",
          "type": "object?",
