{
  "schema": "TPAA_AUTHORITY_CHANGE_PROPOSAL_V1",
  "proposal_id": "ACP-216",
  "issue": 216,
  "title": "Exact persistence completeness beyond DB 1.6.0",
  "status": "PROPOSED_NOT_ADOPTED",
  "current_authority": {
    "core_baseline": "CB-1.4.0",
    "db_schema_version": "1.6.0",
    "source_b1_protected_main_sha": "1ae7fccd6b61f570e22b7622c74fe41a4a7fe6c8"
  },
  "candidate_authority": {
    "db_schema_version": "1.7.0",
    "adoption_state": "NONE",
    "canonical_files_modified_by_this_proposal": false,
    "migration_created_by_this_proposal": false
  },
  "design_principles": [
    "Additive companion relations are preferred over semantic overloading of existing JSONB columns.",
    "Every new relation has one named semantic authority and may not duplicate an existing canonical field.",
    "Historical exact reads must never fall back to current/latest state.",
    "Workflow idempotency survives restart through a dedicated governed mutation-idempotency relation.",
    "SQLite and PostgreSQL must project the same logical records.",
    "No existing P1-P6 claim, admission, RBAC, privacy or evidence semantics are weakened."
  ],
  "changes": [
