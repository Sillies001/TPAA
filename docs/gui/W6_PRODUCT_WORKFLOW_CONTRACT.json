{
  "schema": "TPAA_W6_PRODUCT_WORKFLOW_CONTRACT_V1",
  "baseline": "TPAA_V8.0_ED-2.0_Rebaseline_R3.3",
  "current_latest_fallback_forbidden": true,
  "frontend_business_recompute_forbidden": true,
  "pages": [
